---
import { getImage } from 'astro:assets';
import Button from '../ui/Button.astro';
import { getWhatsAppUrl, siteConfig } from '../../config/site';
import { content } from '../../data/content';
import contactPortrait from '../../assets/dra-apresentacao.webp';

const whatsappUrl = getWhatsAppUrl();
const [contactTitleBefore, contactTitleAfter] = content.contact.title.split(
  content.contact.titleEmphasis
);
// Iris 12.3 (A-11): the same portrait as Sobre, blended in luminosity mode so the panel stays navy.
const ambient = await getImage({ src: contactPortrait, width: 64, format: 'webp', quality: 50 });
---

<section class="section contact" id="contato" aria-labelledby="contact-title" data-cta-scroll style={`--ambient: url(${ambient.src})`}>
  <div class="container contact__layout" data-cta>
    <div class="contact__panel" data-cta-panel>
      <div class="contact__copy">
        <p class="section-eyebrow" data-cta-step style="--cta-delay: 100ms">{content.contact.eyebrow}</p>
        <h2 class="section-heading" id="contact-title" data-cta-step style="--cta-delay: 200ms">{contactTitleBefore}<em>{content.contact.titleEmphasis}</em>{contactTitleAfter}</h2>
        <p class="section-description" data-cta-step style="--cta-delay: 300ms">{content.contact.description}</p>
        <div class="contact__action" data-cta-step style="--cta-delay: 500ms">
          <Button href={whatsappUrl} label={content.contact.cta} external={whatsappUrl.startsWith('https://')} whatsappLocation="contato" />
          <p class="contact__detail">{content.contact.detail}</p>
        </div>
        {(siteConfig.address || siteConfig.businessHours || siteConfig.crfa || siteConfig.cnpj) && (
          <aside class="contact__details" aria-label="Informações de contato">
            {siteConfig.address && <p>{siteConfig.address}</p>}
            {siteConfig.businessHours && <p>{siteConfig.businessHours}</p>}
            {siteConfig.crfa && <p>CRFa {siteConfig.crfa}</p>}
            {siteConfig.cnpj && <p>CNPJ {siteConfig.cnpj}</p>}
          </aside>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/cta-motion';
</script>
