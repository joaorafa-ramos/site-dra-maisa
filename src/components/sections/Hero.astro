---
import Button from '../ui/Button.astro';
import { getWhatsAppUrl } from '../../config/site';
import { content } from '../../data/content';

const whatsappUrl = getWhatsAppUrl();
---

<section class="hero" aria-labelledby="hero-title">
  <img
    class="hero__image"
    src="/images/hero-maisa.webp"
    alt="Maisa Palma sentada à mesa em um consultório infantil."
    width="1440"
    height="804"
    loading="eager"
    fetchpriority="high"
  />
  <div class="container hero__layout">
    <div class="hero__content">
      <p class="hero__eyebrow">{content.hero.eyebrow}</p>
      <h1 id="hero-title" class="section-heading hero__title">{content.hero.title}</h1>
      <p class="hero__description">{content.hero.description}</p>
      <Button href={whatsappUrl} label={content.hero.cta} external={whatsappUrl.startsWith('https://')} />
    </div>
  </div>
</section>
