---
import Button from '../ui/Button.astro';
import { getWhatsAppUrl } from '../../config/site';
import { content, evaluationSteps } from '../../data/content';

const whatsappUrl = getWhatsAppUrl();
---

<section class="section evaluation" id="avaliacao" aria-labelledby="evaluation-title" data-reveal-group="evaluation">
  <div class="container">
    <div class="evaluation__intro" data-reveal>
      <p class="section-eyebrow">{content.evaluation.eyebrow}</p>
      <h2 class="section-heading" id="evaluation-title">{content.evaluation.title}</h2>
      <p class="section-description">{content.evaluation.description}</p>
    </div>
    <div class="evaluation__timeline">
      <span class="evaluation__line" aria-hidden="true"></span>
      <ol class="evaluation__steps" role="list" data-reveal-stagger>
        {evaluationSteps.map(step => (
          <li class="evaluation-step" data-reveal>
            <span class="evaluation-step__number" aria-hidden="true">{step.step}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
    <div class="evaluation__closing" data-reveal>
      <p class="evaluation__reassurance">{content.evaluation.reassurance}</p>
      <div class="evaluation__action">
        <Button href={whatsappUrl} label={content.evaluation.cta} external={whatsappUrl.startsWith('https://')} whatsappLocation="avaliacao" />
        <p class="evaluation__cta-detail">{content.evaluation.ctaDetail}</p>
      </div>
    </div>
  </div>
</section>
