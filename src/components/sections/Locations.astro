---
import { formatAddress, locations } from '../../data/locations';
---

<section class="section locations" id="localizacoes" aria-labelledby="locations-title">
  <div class="container">
    <div class="locations__intro">
      <p class="section-eyebrow">Localizações</p>
      <h2 class="section-heading" id="locations-title">Onde encontrar o atendimento</h2>
    </div>
    <div class="locations__grid" data-reveal-stagger>
      {locations.map((location, index) => (
        <article class="location-card" data-location-card data-reveal="card" style={`--i:${Math.min(index, 5)}`}>
          <div class="location-card__body">
            <svg class="location-card__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 6.5 9 3l6 3.5L21 3v14.5L15 21l-6-3.5L3 21V6.5Z" />
              <path d="M9 3v14.5M15 6.5V21" />
            </svg>
            <div class="location-card__copy">
              <p class="location-card__name">{location.name}</p>
              <p class="location-card__address">{formatAddress(location)}</p>
            </div>
            <div class="location-card__actions">
              <a
                href={location.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="location-card__directions"
                data-map-directions
                data-location-id={location.id}
              >Como chegar <span aria-hidden="true">↗</span></a>
              <button
                type="button"
                class="location-card__map-toggle"
                data-location-map-toggle
                data-embed-url={location.embedUrl}
                aria-expanded="false"
                aria-controls={`location-map-${location.id}`}
                aria-label={`Ver mapa da ${location.name}`}
              >Ver mapa</button>
            </div>
          </div>
          <div class="location-card__map" id={`location-map-${location.id}`} data-location-map hidden></div>
        </article>
      ))}
    </div>
  </div>
</section>
