---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Hero from '../components/sections/Hero.astro';
import Signals from '../components/sections/Signals.astro';
import About from '../components/sections/About.astro';
import Evaluation from '../components/sections/Evaluation.astro';
import Areas from '../components/sections/Areas.astro';
import Faq from '../components/sections/Faq.astro';
import Contact from '../components/sections/Contact.astro';
import Locations from '../components/sections/Locations.astro';
import Footer from '../components/layout/Footer.astro';
---

<BaseLayout>
  <Header />
  <main id="conteudo">
    <Hero />
    <Signals />
    <About />
    <Evaluation />
    <Areas />
    <Faq />
    <Contact />
    <Locations />
  </main>
  <Footer />
</BaseLayout>
