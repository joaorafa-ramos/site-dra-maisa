---
interface Props {
  href: string;
  label: string;
  variant?: 'peach' | 'navy';
  external?: boolean;
  whatsappLocation?: string;
}

const { href, label, variant = 'peach', external = false, whatsappLocation } = Astro.props;
const whatsappEventHandler = whatsappLocation
  ? `window.dispatchEvent(new CustomEvent('whatsapp_click', { detail: { cta_location: ${JSON.stringify(whatsappLocation)}, cta_label: ${JSON.stringify(label)} } }));`
  : undefined;
---

<a
  class:list={['button', `button--${variant}`]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-whatsapp-cta={whatsappLocation ? '' : undefined}
  data-whatsapp-location={whatsappLocation}
  data-whatsapp-label={whatsappLocation ? label : undefined}
  onclick={whatsappEventHandler}
>
  {label}
</a>
