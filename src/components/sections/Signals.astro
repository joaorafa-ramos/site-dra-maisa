---
import { getImage } from 'astro:assets';
import Button from '../ui/Button.astro';
import PictureFrame from '../ui/PictureFrame.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { getWhatsAppUrl } from '../../config/site';
import { content, signals } from '../../data/content';
import sinaisPortrait from '../../assets/sinais-maisa.webp';

const whatsappUrl = getWhatsAppUrl();
const [signalsTitleBefore, signalsTitleAfter] = content.signals.title.split(content.signals.titleEmphasis);
// Iris 12.2: a 64px render is already naturally blurred and costs ~1-2KB; never the full-size asset.
const ambient = await getImage({ src: sinaisPortrait, width: 64, format: 'webp', quality: 50 });
---

<section class="section signals" id="sinais" style={`--ambient: url(${ambient.src})`}>
  <div class="container">
    <div class="signals__intro" data-reveal="group">
      <p class="section-eyebrow">{content.signals.eyebrow}</p>
      <SectionHeading>{signalsTitleBefore}<em>{content.signals.titleEmphasis}</em>{signalsTitleAfter}</SectionHeading>
      <p class="section-description">{content.signals.description}</p>
    </div>
    <div class="signals__layout">
      <PictureFrame
        class="signals__portrait"
        reveal="image"
        src={sinaisPortrait}
        width={800}
        height={1000}
        widths={[420, 640, 800]}
        sizes="(max-width: 959px) 420px, 520px"
        alt="Maisa Palma segurando um brinquedo de dinossauro no consultório."
      />
      <ul class="signals__list" role="list" data-reveal-stagger>
        {signals.map((signal, index) => (
          <li class="signal-item" data-motion-card data-reveal="card" style={`--i:${Math.min(index, 5)}`}>
            <h3 class="signal-item__title">{signal.title}</h3>
            <p>{signal.description}</p>
          </li>
        ))}
      </ul>
    </div>
    <div class="signals__action">
      <p class="signals__reassurance">{content.signals.reassurance}</p>
      <Button href={whatsappUrl} label={content.signals.cta} external={whatsappUrl.startsWith('https://')} whatsappLocation="sinais" />
    </div>
  </div>
</section>
