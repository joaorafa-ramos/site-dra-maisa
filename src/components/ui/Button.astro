---
interface Props {
  href: string;
  label: string;
  variant?: 'peach' | 'navy' | 'link';
  external?: boolean;
  whatsappLocation?: string;
  arrow?: boolean;
}

const { href, label, variant = 'peach', external = false, whatsappLocation, arrow = false } = Astro.props;
---

<a
  class:list={variant === 'link' ? ['link-secondary'] : ['button', `button--${variant}`]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-whatsapp-cta={whatsappLocation ? '' : undefined}
  data-whatsapp-location={whatsappLocation}
  data-whatsapp-label={whatsappLocation ? label : undefined}
>
  {variant !== 'link' && whatsappLocation && (
    <svg class="button__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20Zm4.4-5.8c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.2-.6.8-.8 1-.1.2-.3.2-.5.1-1.4-.7-2.3-1.2-3.2-2.8-.2-.4.2-.4.6-1.2.1-.1 0-.3 0-.4-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.8 2.2 1 2.4c.1.2 1.6 2.5 3.9 3.5.5.2.9.4 1.3.5.5.2 1 .1 1.4-.1.4-.2 1.3-.5 1.5-1.1.2-.5.2-1 .1-1.1-.1-.1-.2-.2-.4-.3Z" />
    </svg>
  )}
  <span class="button__label">{label}</span>{arrow && <span aria-hidden="true"> ↗</span>}
</a>
