---
import type { SignalIconName } from '../../types/signals';

interface Props {
  icon: SignalIconName;
}

const { icon } = Astro.props;
---

<span class="signal-card__icon" data-signal-icon={icon} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    {icon === 'few-words' && (
      <g>
        <path d="M5 6.5h10a3 3 0 0 1 3 3v3a3 3 0 0 1-3 3H9l-4 3v-3a3 3 0 0 1-3-3v-3a3 3 0 0 1 3-3Z" />
        <path d="M8 11h.01M11.5 11h.01M15 11h.01" stroke-width="2.6" />
      </g>
    )}
    {icon === 'sound-change' && (
      <g>
        <path d="M4 10h3l4-3v10l-4-3H4Z" />
        <path d="M15 10c1 .7 1 .7 0 1M17.5 8.2c2.3 2.1 2.3 5.5 0 7.6" />
        <path d="m15 16 4-8" />
      </g>
    )}
    {icon === 'clarity' && (
      <g>
        <path d="M5 5.5h11a3 3 0 0 1 3 3v4a3 3 0 0 1-3 3h-5l-4 3v-3a3 3 0 0 1-2-2.8" />
        <path d="M12 8.5a1.8 1.8 0 0 1 1.8 1.8c0 1.2-1.8 1.4-1.8 2.6M12 15.5h.01" />
      </g>
    )}
    {icon === 'frustration' && (
      <g>
        <circle cx="12" cy="12" r="8" />
        <path d="m8.5 9 2 1M15.5 9l-2 1M8.5 16c1.8-1.6 5.2-1.6 7 0" />
      </g>
    )}
    {icon === 'understanding' && (
      <g>
        <path d="M8 15c-1.8-1-2.5-2.8-2.5-5.2 0-3.2 2-5.3 4.9-5.3 2.7 0 4.6 1.9 4.6 4.6 0 2.4-1 4-2.8 4.8-.8.4-1.2 1-1.2 2.1" />
        <path d="M8.5 18.5c.9.8 2.2.8 3.1 0" />
        <path d="M15.5 14.5h3a2 2 0 0 1 2 2v1.2a2 2 0 0 1-2 2h-1.8l-2.2 1.6v-1.6" />
      </g>
    )}
    {icon === 'conversation-avoidance' && (
      <g>
        <path d="M4 5.5h8a2.5 2.5 0 0 1 2.5 2.5v2A2.5 2.5 0 0 1 12 12.5H8l-3 2.3v-2.5A2.5 2.5 0 0 1 4 10Z" />
        <path d="M13 13.5h5a2 2 0 0 1 2 2V17a2 2 0 0 1-2 2h-2l-2 1.5V19" />
        <path d="m4 20 16-16" />
      </g>
    )}
  </svg>
</span>
