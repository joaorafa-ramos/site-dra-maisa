---
interface Props {
  src?: string;
  alt: string;
  width: number;
  height: number;
  eager?: boolean;
  class?: string;
}

const { src, alt, width, height, eager = false, class: className } = Astro.props;
---

<div class:list={['picture-frame', className]} style={`aspect-ratio: ${width} / ${height};`}>
  {src ? (
    <img src={src} alt={alt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} />
  ) : (
    <div class="picture-frame__slot" role="img" aria-label={alt}></div>
  )}
</div>
