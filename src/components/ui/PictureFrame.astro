---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt: string;
  width: number;
  height: number;
  widths: number[];
  sizes?: string;
  eager?: boolean;
  class?: string;
  reveal?: 'image';
}

const {
  src,
  alt,
  width,
  height,
  widths,
  sizes = '420px',
  eager = false,
  class: className,
  reveal,
} = Astro.props;
---

<div
  class:list={['picture-frame', className]}
  data-reveal={reveal}
  style={`aspect-ratio: ${width} / ${height};`}
>
  {src ? (
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={widths}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
    />
  ) : (
    <div class="picture-frame__slot" role="img" aria-label={alt}></div>
  )}
</div>
