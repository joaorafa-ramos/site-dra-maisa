---
import Button from '../ui/Button.astro';
import { getWhatsAppUrl } from '../../config/site';
import { areas, content } from '../../data/content';

const whatsappUrl = getWhatsAppUrl();
---

<section class="section areas" id="areas" aria-labelledby="areas-title" data-reveal-group="areas">
  <div class="container">
    <div class="areas__intro" data-reveal>
      <p class="section-eyebrow">{content.areas.eyebrow}</p>
      <h2 class="section-heading" id="areas-title">{content.areas.title}</h2>
      <p class="section-description">{content.areas.description}</p>
    </div>
    <ul class="areas__grid" role="list" data-reveal-stagger>
      {areas.map(area => (
        <li class="area-card" data-area-card data-area={area.title} data-reveal>
          <span class="area-card__bar" aria-hidden="true"></span>
          <span class="area-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="m8.5 12.2 2.3 2.3 4.7-4.9" />
            </svg>
          </span>
          <p class="area-card__category">{area.category}</p>
          <h3>{area.title}</h3>
          <p class="area-card__summary">{area.front}</p>
        </li>
      ))}
    </ul>
    <div class="areas__action" data-reveal>
      <Button href={whatsappUrl} label={content.areas.cta} external={whatsappUrl.startsWith('https://')} whatsappLocation="areas" />
    </div>
  </div>
</section>
