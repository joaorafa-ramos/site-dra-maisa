---
import Button from '../ui/Button.astro';
import PictureFrame from '../ui/PictureFrame.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import SignalIcon from '../ui/SignalIcon.astro';
import { getWhatsAppUrl } from '../../config/site';
import { content, signals } from '../../data/content';

const whatsappUrl = getWhatsAppUrl();
---

<section class="section signals" id="sinais">
  <div class="container">
    <div class="signals__intro">
      <div class="signals__copy">
        <p class="section-eyebrow">{content.signals.eyebrow}</p>
        <SectionHeading>{content.signals.title}</SectionHeading>
        <p class="section-description">{content.signals.description}</p>
        <p class="signals__reassurance">{content.signals.reassurance}</p>
        <Button href={whatsappUrl} label={content.signals.cta} variant="navy" external={whatsappUrl.startsWith('https://')} whatsappLocation="sinais" />
      </div>
      <PictureFrame
        class="signals__portrait"
        src="/images/sinais-maisa.optimized.webp"
        alt="Maisa Palma segurando um brinquedo de dinossauro no consultório."
        width={800}
        height={1000}
      />
    </div>
    <ol class="signals__list">
      {signals.map((signal, index) => (
        <li class="signal-card">
          <span class="signal-card__number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <SignalIcon icon={signal.icon} />
          <div class="signal-card__content">
            <h3>{signal.title}</h3>
            <p>{signal.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
