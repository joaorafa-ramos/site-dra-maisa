---
import AreaIcon from '../ui/AreaIcon.astro';
import Button from '../ui/Button.astro';
import { getWhatsAppUrl } from '../../config/site';
import { areas, content } from '../../data/content';

const whatsappUrl = getWhatsAppUrl();
const [areasTitleBefore, areasTitleAfter] = content.areas.title.split(content.areas.titleEmphasis);
---

<section class="section areas" id="areas" aria-labelledby="areas-title" data-reveal-group="areas">
  <div class="container">
    <div class="areas__intro" data-reveal="group">
      <p class="section-eyebrow">{content.areas.eyebrow}</p>
      <h2 class="section-heading" id="areas-title">{areasTitleBefore}<em>{content.areas.titleEmphasis}</em>{areasTitleAfter}</h2>
      <p class="section-description">{content.areas.description}</p>
    </div>
    <ul class="areas__grid" role="list" data-reveal-stagger>
      {areas.map((area, index) => (
        <li class="area-card" data-area-card data-motion-card data-area={area.title} data-reveal="card" style={`--i:${Math.min(index, 5)}`}>
          <span class="area-card__icon" aria-hidden="true"><AreaIcon name={area.icon} /></span>
          <h3>{area.title}</h3>
          <p class="area-card__summary">{area.front}</p>
        </li>
      ))}
    </ul>
    <div class="areas__action" data-reveal>
      <Button
        href={whatsappUrl}
        label={content.areas.cta}
        variant="link"
        arrow
        external={whatsappUrl.startsWith('https://')}
        whatsappLocation="areas"
      />
    </div>
  </div>
</section>
