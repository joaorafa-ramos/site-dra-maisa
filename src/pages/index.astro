---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Hero from '../components/sections/Hero.astro';
import Signals from '../components/sections/Signals.astro';
import About from '../components/sections/About.astro';
import Evaluation from '../components/sections/Evaluation.astro';
import Benefits from '../components/sections/Benefits.astro';
import Areas from '../components/sections/Areas.astro';
---

<BaseLayout>
  <Header />
  <main id="conteudo">
    <Hero />
    <Signals />
    <About />
    <Evaluation />
    <Benefits />
    <Areas />
    <!-- These empty navigation targets are replaced by the sections in later tasks. -->
    <section id="duvidas"></section>
    <section id="contato"></section>
  </main>
</BaseLayout>
