---
import Button from '../ui/Button.astro';
import { getWhatsAppUrl, siteConfig } from '../../config/site';
import { content } from '../../data/content';

const whatsappUrl = getWhatsAppUrl();
---

<section class="section contact" id="contato" aria-labelledby="contact-title">
  <div class="container contact__layout">
    <div class="contact__copy">
      <p class="section-eyebrow">{content.contact.eyebrow}</p>
      <h2 class="section-heading" id="contact-title">{content.contact.title}</h2>
      <p class="section-description">{content.contact.description}</p>
      <Button href={whatsappUrl} label={content.contact.cta} external={whatsappUrl.startsWith('https://')} whatsappLocation="contato" />
    </div>
    <aside class="contact__details" aria-label="Informações de contato">
      <p>{content.footer.specialization} em {siteConfig.city}</p>
      <a href={siteConfig.instagramUrl} target="_blank" rel="noopener noreferrer">{siteConfig.instagram}</a>
      {siteConfig.address && <p>{siteConfig.address}</p>}
      {siteConfig.businessHours && <p>{siteConfig.businessHours}</p>}
      {siteConfig.crfa && <p>CRFa {siteConfig.crfa}</p>}
      {siteConfig.cnpj && <p>CNPJ {siteConfig.cnpj}</p>}
    </aside>
  </div>
</section>
