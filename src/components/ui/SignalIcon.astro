---
import type { SignalIconName } from '../../types/signals';

interface Props {
  icon: SignalIconName;
}

const { icon } = Astro.props;
---

<span class="signal-card__icon" data-signal-icon={icon} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    {icon === 'few-words' && (
      <g>
        <path d="M5 5h11a4 4 0 0 1 4 4v3a4 4 0 0 1-4 4h-5.4L6 19.5V16a4 4 0 0 1-3-3.9V9a4 4 0 0 1 2-4Z" />
        <circle cx="8.5" cy="10.5" r="1" fill="var(--color-pale-blue)" />
        <circle cx="12.5" cy="10.5" r="1" fill="var(--color-pale-blue)" />
        <circle cx="16.5" cy="10.5" r="1" fill="var(--color-pale-blue)" />
      </g>
    )}
    {icon === 'sound-change' && (
      <g>
        <path d="M3 9h4l5-4v14l-5-4H3Z" />
        <path d="M15 8.2a1 1 0 0 1 1.4 0 5.4 5.4 0 0 1 0 7.6 1 1 0 1 1-1.4-1.4 3.4 3.4 0 0 0 0-4.8 1 1 0 0 1 0-1.4Z" />
        <path d="M18 5.5a1 1 0 0 1 1.4 0 9.2 9.2 0 0 1 0 13 1 1 0 1 1-1.4-1.4 7.2 7.2 0 0 0 0-10.2 1 1 0 0 1 0-1.4Z" />
      </g>
    )}
    {icon === 'clarity' && (
      <g>
        <path d="M5 4h12a4 4 0 0 1 4 4v5a4 4 0 0 1-4 4h-5.8L6 20v-3.4A4 4 0 0 1 3 13V8a4 4 0 0 1 2-4Z" />
        <path d="m8.3 11.9 2.2 2.2 5.2-5.2" fill="none" stroke="var(--color-pale-blue)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    )}
    {icon === 'frustration' && (
      <g>
        <circle cx="12" cy="12" r="9" />
        <circle cx="8.6" cy="10" r="1.15" fill="var(--color-pale-blue)" />
        <circle cx="15.4" cy="10" r="1.15" fill="var(--color-pale-blue)" />
        <path d="M8.3 16c1.9-1.7 5.5-1.7 7.4 0" fill="none" stroke="var(--color-pale-blue)" stroke-width="2" stroke-linecap="round" />
      </g>
    )}
    {icon === 'understanding' && (
      <g>
        <path d="M10.6 3.5a6.1 6.1 0 0 0-5.1 9.4c.7 1.1 1.7 1.8 2.8 2.3v2.8h5.2v-2.8a6.1 6.1 0 0 0-2.9-11.7Z" />
        <path d="M15.3 13.2h4a2.2 2.2 0 0 1 2.2 2.2v1.4a2.2 2.2 0 0 1-2.2 2.2h-1.8L15 21v-2.1a2.2 2.2 0 0 1-1.9-2.1v-1.4a2.2 2.2 0 0 1 2.2-2.2Z" />
        <circle cx="9.4" cy="9.3" r="1.05" fill="var(--color-pale-blue)" />
      </g>
    )}
    {icon === 'conversation-avoidance' && (
      <g>
        <path d="M4 4h9a4 4 0 0 1 4 4v2a4 4 0 0 1-4 4H9l-5 3.5V14a4 4 0 0 1-3-3.9V8a4 4 0 0 1 3-4Z" />
        <path d="M15 14h4a3 3 0 0 1 3 3v1a3 3 0 0 1-3 3h-2l-3 2v-2.3a3 3 0 0 1-2-2.7v-1a3 3 0 0 1 3-3Z" />
        <path d="m4 21 17-17" fill="none" stroke="var(--color-pale-blue)" stroke-width="2.6" stroke-linecap="round" />
      </g>
    )}
  </svg>
</span>
