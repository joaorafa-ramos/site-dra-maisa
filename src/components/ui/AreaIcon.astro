---
// Redrawn from the logo's 5 pictograms (logo.maisa.pdf — embedded as a raster image, no vector paths to
// extract; traced by hand instead), matched to the 6 areas of practice. "hand" doubles for "linguagem",
// the one area without a direct pictogram (documented in forja.md).
export type AreaIconName = 'eye' | 'ear' | 'mouth' | 'nose' | 'hand';

interface Props {
  name: AreaIconName;
}

const { name } = Astro.props;
---

{name === 'eye' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M2 12c2.4-4.3 6.2-6.8 10-6.8S19.6 7.7 22 12c-2.4 4.3-6.2 6.8-10 6.8S4.4 16.3 2 12Z" />
    <circle cx="12" cy="12" r="3" />
    <circle cx="12" cy="12" r="0.6" fill="currentColor" stroke="none" />
  </svg>
)}
{name === 'ear' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M14 3a6.5 6.5 0 0 0-6.5 6.5c0 2.1.9 3.2 1.8 4.3.7.9 1.2 1.6 1.2 2.7a2.5 2.5 0 0 0 5 0" />
    <path d="M14 3a6.5 6.5 0 0 1 6.5 6.5c0 2.6-1.4 3.6-2.5 5-.8 1-1.3 1.8-1.3 3" />
    <path d="M11.2 10.2a2.8 2.8 0 0 1 2.8-2.7" />
  </svg>
)}
{name === 'mouth' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 9.5c2-2 5-3 8-3s6 1 8 2" />
    <path d="M4 9.5c2.5 5.2 5.5 7.7 8 7.7s5.5-2.5 8-7.7" />
    <path d="M12 10v3.8" />
  </svg>
)}
{name === 'nose' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M10.2 3c0 3.8-1.8 6.3-2 8.8" />
    <path d="M13.8 3c0 3.8 1.8 6.3 2 8.8" />
    <circle cx="9.4" cy="14.3" r="1.9" />
    <circle cx="14.6" cy="14.3" r="1.9" />
  </svg>
)}
{name === 'hand' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M8.3 21v-8.7a1.3 1.3 0 0 1 2.6 0V15" />
    <path d="M10.9 15V6.2a1.3 1.3 0 0 1 2.6 0V14" />
    <path d="M13.5 14V6.8a1.3 1.3 0 0 1 2.6 0V14" />
    <path d="M16.1 14V8.3a1.3 1.3 0 0 1 2.6 0v6.9c0 3.2-2 5.8-5.2 5.8h-1.8c-1.9 0-2.9-1-3.9-2.5L5.2 14.6a1.3 1.3 0 0 1 2-1.6l1.1 1.3" />
  </svg>
)}
