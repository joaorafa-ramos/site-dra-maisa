---
import Button from '../ui/Button.astro';
import PictureFrame from '../ui/PictureFrame.astro';
import { getWhatsAppUrl } from '../../config/site';
import { content } from '../../data/content';

const whatsappUrl = getWhatsAppUrl();
---

<section class="section final-cta" id="conversar" aria-labelledby="final-cta-title">
  <div class="container final-cta__layout">
    <div class="final-cta__copy">
      <p class="section-eyebrow">{content.finalCta.eyebrow}</p>
      <h2 class="section-heading" id="final-cta-title">{content.finalCta.title}</h2>
      <p class="section-description">{content.finalCta.description}</p>
      <Button href={whatsappUrl} label={content.finalCta.cta} external={whatsappUrl.startsWith('https://')} />
      <p class="final-cta__detail">{content.finalCta.detail}</p>
    </div>
    <PictureFrame
      class="final-cta__portrait"
      alt="Espaço reservado para retrato da Dra. Maisa"
      width={350}
      height={438}
    />
  </div>
</section>
